# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get a FREE key at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — safe to leave as-is
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Any edge-tts voice name works. Run `edge-tts --list-voices` to see options.
ELLIE_VOICE=en-US-AriaNeural

MAX_HISTORY_MESSAGES=20
